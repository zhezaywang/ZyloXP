{
  "name": "zylo-xp",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based electrical engineering workbench with circuit labs, PCB layout, and practice.",
  "homepage": "https://zhezaywang.github.io/ZyloXP/",
  "type": "module",
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "test:pcb": "node --experimental-strip-types --test tests/pcbStorage.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm run test && pnpm run build && pnpm run test:e2e",
    "screenshots": "pnpm run build && node tools/capture-previews.mjs",
    "sync:bank": "python3 tools/sync_question_bank.py",
    "security:check": "pnpm audit --prod --audit-level=high && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
